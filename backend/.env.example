# 复制为.env，填写本地配置。不要提交真实值。
DATABASE_URL=
JWT_SECRET_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
BASE_URL=https://api.deepseek.com/v1
TEMPERATURE=0.7

# 本地开发；生产须使用HTTPS并设置实际允许的访问来源。
APP_ENV=development
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_MAX_SECONDS=7200
AUTH_SESSION_IDLE_SECONDS=1800

# 当前CPU测试配置；首次下载完整模型时改为1，之后恢复0。
LOCAL_MODEL_ALLOW_DOWNLOAD=0
LOCAL_INFERENCE_THREADS=2
LOCAL_INFERENCE_CONCURRENCY=1
RERANK_BATCH_SIZE=2
RERANK_MAX_CANDIDATES=20
QUERY_VECTOR_CACHE_SIZE=512

# 当前排障配置：0关闭业务执行时限，仍保留登录与任务租约校验。
SSE_TIMEOUT_SECONDS=0
LLM_REQUEST_TIMEOUT_SECONDS=0
INTENT_REQUEST_TIMEOUT_SECONDS=0
TOOL_QUERY_TIMEOUT_MS=0
RAG_QUERY_TIMEOUT_MS=0

# 应用Token预算；参考编码估算，不是服务商精确计费值。
LLM_TOTAL_TOKEN_BUDGET=16384
LLM_MAX_OUTPUT_TOKENS=2048
TOKEN_SAFETY_MARGIN=1.15
